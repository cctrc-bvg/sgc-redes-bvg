# Copie para .env e troque TODOS os valores antes de subir em produção.

# --- Banco de dados (usado pelo docker-compose) ---
POSTGRES_USER=sgc_redes
POSTGRES_PASSWORD=trocar_esta_senha_em_producao
POSTGRES_DB=sgc_redes_ifce

# Desenvolvimento local fora do Docker (npm run dev / prisma).
# Dentro do Docker Compose esta variável é montada automaticamente a partir das acima.
DATABASE_URL=postgresql://sgc_redes:trocar_esta_senha_em_producao@localhost:5432/sgc_redes_ifce?schema=public

# --- Aplicação ---
# Endereço público do sistema. Com https:// o cookie de sessão é marcado como Secure;
# use http:// apenas para testes locais (ex.: http://localhost:3000).
APP_URL=http://localhost:3000

# --- Usuário coordenador inicial (seed) ---
# Opcional. Se SEED_COORDENADOR_SENHA ficar vazia, o seed gera uma senha aleatória e a exibe
# uma única vez. Em qualquer caso, a troca de senha é exigida no primeiro acesso.
SEED_COORDENADOR_EMAIL=cctrc.boaviagem@ifce.edu.br
SEED_COORDENADOR_SENHA=

# --- WhatsApp automático (opcional: Evolution API / n8n no campus) ---
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
